# Luantiで使用するゲームID（デフォルト: mineclonia）
LUANTI_GAME_ID=mineclonia

# 作成・起動するワールド名（デフォルト: world）
LUANTI_WORLD_NAME=world

# Luantiサーバーの待受UDPポート（デフォルト: 30000）
LUANTI_PORT=30000

# Luanti設定ファイルの取得URL
LUANTI_CONF_URL=https://raw.githubusercontent.com/CoderDojo-Odawara/PaaS_Luanti_Server/main/luanti.conf

# ゲーム本体（mineclonia）のダウンロードURL
GAME_DOWNLOAD_URL=https://content.luanti.org/packages/ryvnf/mineclonia/download/

# xcompat MODのダウンロードURL
MOD_XCOMPAT_URL=https://content.luanti.org/packages/mt-mods/xcompat/download/

# lwscratch MODのダウンロードURL
MOD_LWSCRATCH_URL=https://content.luanti.org/packages/mt-mods/lwscratch/download/

# バックアップ保持日数（将来の運用拡張向け）
BACKUP_RETAIN_DAYS=7

# SHA256ハッシュ値（初回ダウンロード時に取得して設定してください）
# SHA256_LUANTI_CONF=
# SHA256_GAME=
# SHA256_MOD_XCOMPAT=
# SHA256_MOD_LWSCRATCH=
